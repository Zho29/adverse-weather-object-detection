# ──────────────────────────────────────────────────────────────────────────────
# Adverse Weather Object Detection — Project .gitignore
# ──────────────────────────────────────────────────────────────────────────────

# ── Video files ───────────────────────────────────────────────────────────────
*.mp4
*.avi
*.mov
*.mkv

# ── Large datasets (81 GB+) — keep only code / scripts ───────────────────────
experiments/Foggy_Cityscapes_dataset/
experiments/yolo_dataset_beta0.01_restored/
experiments/yolo_dataset_beta0.02/
experiments/yolo_dataset_beta0.02_baseline/
experiments/yolo_dataset_beta0.02_restored/
experiments/clear_image_baseline_dataset/
experiments/clear_image_eval_dataset/
experiments/acdcbaseline/
experiments/yolo_baseline_foggy_beta0.02/

# ── Virtual environment ───────────────────────────────────────────────────────
experiments/wunet_yolo_env/

# ── Third-party frameworks (cloned, not original code) ────────────────────────
experiments/mmdetection/
experiments/mmcv_source/

# ── Log files ─────────────────────────────────────────────────────────────────
*.log

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# ── Jupyter checkpoints ───────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── OS metadata ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Model checkpoints tracked by Git LFS (see .gitattributes) ────────────────
# (*.pth and *.pt are tracked via LFS — NOT ignored)

# ── Large result JSON files ───────────────────────────────────────────────────
experiments/dsnet_adapter_dino_results.json
experiments/dsnet_dino_detection_results.json

# ── Generated output directories with thousands of images ─────────────────────
experiments/baseline_yolo_detections/
experiments/dsnet_dino_detections/
experiments/dsnet_dino_visualizations/
experiments/wunet_yolo_detections/
experiments/clear_comparison_visualizations/
experiments/video_detections/
experiments/yolo_visualizations_final/
experiments/yolo_visualizations_high_fog/
experiments/high_fog_results/
experiments/baseline_yolo_clear_detections/

# ── Intermediate ACDC results packages ───────────────────────────────────────
experiments/ACDC_Results_Packages/

# ── DSNET __pycache__ and large logs ─────────────────────────────────────────
experiments/DSNET/__pycache__/
experiments/WUNET/__pycache__/

# ── Generated metrics (runtime output) ───────────────────────────────────────
video_detection_analysis/comparison_metrics.json

# Local environments and package tooling
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local configuration and credentials
.env
.env.*
!.env.example
.idea/
.vscode/

# Scratch experiments (historical tracked artifacts remain available)
/outputs/
